@model TuProyecto.Models.OrderModel
@{
    Layout = null;
    var o = Model;
}
<div class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar reservación</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <form id="editOrderForm">
            <input type="hidden" name="id" value="@o.Id" />
            <div class="mb-3">
                <label class="form-label">Sucursal</label>
                <input class="form-control" value="@o.BranchName" readonly style="background:#f6f6f6; color:#4b5563;" />
            </div>
            <div class="mb-3">
                <label class="form-label">Fecha</label>
                <input class="form-control" id="editOrderDate" value="@o.Date" readonly style="background:#f6f6f6; color:#4b5563;" />
            </div>
            <div class="mb-3">
                <label class="form-label">Hora</label>
                <select name="hour" class="form-select" required>
                    @{
                        var hours = Enumerable.Range(9, 12).Select(h => h.ToString("D2") + ":00");
                        foreach(var h in hours)
                        {
                            var sel = o.Hour == h ? " selected=\"selected\"" : "";
                            @Html.Raw($"<option value=\"{h}\"{sel}>{h}</option>")
                        }
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Personas</label>
                <select name="persons" id="editPersonsSelect" class="form-select">
                    @{
                        for(int i=1;i<=20;i++)
                        {
                            var sel = o.Persons == i ? " selected=\"selected\"" : "";
                            @Html.Raw($"<option value=\"{i}\"{sel}>{i}</option>")
                        }
                    }
                </select>
                <div id="editCapacityNote" class="form-text text-muted mt-1" style="display:none;"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Notas</label>
                <textarea name="notes" class="form-control">@o.Notes</textarea>
            </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="saveEditBtn">Guardar</button>
      </div>
    </div>
  </div>
</div>

<script>
    // when modal is shown the DOM exists; adjust persons options based on day's remaining capacity
    (async function(){
        try{
            const date = '@o.Date';
            const branchId = '@o.BranchId';
            const currentPersons = parseInt('@o.Persons', 10) || 1;
            const res = await fetch(`/Home/GetAvailability?date=${date}&branchId=${branchId}`);
            if (!res.ok) return;
            const data = await res.json();
            if (!data || !data.success) return;
            const dateRemaining = parseInt(data.dateRemaining || 0, 10);
            const availableIncludingCurrent = Math.min(20, dateRemaining + currentPersons);

            const select = document.getElementById('editPersonsSelect');
            select.innerHTML = '';
            for (let i=1;i<=20;i++){
                const op = document.createElement('option');
                op.value = String(i);
                op.text = String(i);
                if (i > availableIncludingCurrent) op.disabled = true;
                if (i === currentPersons) op.selected = true;
                select.appendChild(op);
            }

            const note = document.getElementById('editCapacityNote');
            if (dateRemaining <= 0) {
                note.style.display = 'block';
                note.innerText = 'Capacidad diaria alcanzada para esta fecha. Solo puedes mantener o reducir las personas.';
            } else if (dateRemaining < 20) {
                note.style.display = 'block';
                note.innerText = `Quedan ${dateRemaining} espacios disponibles para esta fecha.`;
            }
        } catch (e) {
            // ignore failures, keep default options
            console.error('Failed to adjust edit persons options', e);
        }
    })();

    document.getElementById('saveEditBtn').addEventListener('click', async function(){
        const form = document.getElementById('editOrderForm');
        const data = new FormData(form);
        const payload = {
            id: parseInt(data.get('id')),
            hour: data.get('hour'),
            persons: parseInt(data.get('persons')),
            notes: data.get('notes') || ''
        };
        const res = await fetch('/Home/EditOrderSubmit', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        if (res.ok) {
            // prefer existing global showToast if available
            try{ if (window.showToast) window.showToast('Reservación actualizada', true); } catch(e){}
            // hide modal handled by outer code which will reload; ensure a short delay so user sees toast
            setTimeout(()=> location.reload(), 900);
        }
        else {
            const txt = await res.text();
            alert('Error: ' + txt);
        }
    });
</script>