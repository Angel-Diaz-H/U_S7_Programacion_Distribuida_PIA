@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<section class="login-section d-flex align-items-center justify-content-center">
    <div class="login-box p-5 shadow-lg rounded-4 bg-white">
        <div class="text-center mb-4">
            <img src="~/images/Logo1.png" alt="SuperSalads" height="70">
            <h3 class="mt-3 fw-bold text-success">Iniciar Sesión</h3>
            <p class="text-muted mb-4">Accede a tu cuenta</p>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center fw-semibold">@ViewBag.SuccessMessage</div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger text-center fw-semibold">@ViewBag.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label for="username" class="form-label fw-semibold">Usuario</label>
                <input id="username" name="username" class="form-control form-control-lg" placeholder="Ingresa tu usuario" required />
            </div>

            <div class="mb-4">
                <label for="password" class="form-label fw-semibold">Contraseña</label>
                <input id="password" name="password" type="password" class="form-control form-control-lg" placeholder="********" required />
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold mb-2">
                Iniciar Sesión
            </button>

            <!-- Botón de crear cuenta -->
            <a href="/Account/CrearCuenta" class="btn btn-outline-secondary w-100 py-2 fw-bold">
                Crear cuenta
            </a>
        </form>
    </div>
</section>