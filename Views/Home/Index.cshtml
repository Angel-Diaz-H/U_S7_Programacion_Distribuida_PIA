<!-- IMAGEN 2 -->
<section class="hero-below">
    <div class="container-fluid px-0">
        <a asp-controller="Home" asp-action="Reto" class="d-block position-relative w-100" aria-label="Ir al Healthy Challenge">
            <img src="~/images/banner2.png" alt="Imagen Healthy" class="hero-below-img rounded shadow w-100 d-block" />
        </a>
    </div>
