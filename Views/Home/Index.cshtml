<!-- GIFT CARDS -->
<section class="gift-section py-5">
    <div class="container d-flex flex-column flex-lg-row align-items-center justify-content-center gap-5">

        <!-- Carrusel -->
        <div id="giftCardCarousel" class="carousel slide gift-carousel" data-bs-ride="carousel">
            <div class="carousel-inner rounded shadow">
                <div class="carousel-item active">
                    <img src="https://static.wixstatic.com/media/d606f3_629bd8c05521457cbc34eed2bb7c984e~mv2.jpg" class="d-block w-100 rounded" alt="Gift 1">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_a04e05565fa44e77803f5f16c6efa316~mv2.jpg" class="d-block w-100 rounded" alt="Gift 2">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_76c2f1c370a24084a7dc7a33e41e06fc~mv2.jpg" class="d-block w-100 rounded" alt="Gift 3">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_e8bc30ff14d74bdca0da028974f73f32~mv2.jpg" class="d-block w-100 rounded" alt="Gift 4">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#giftCardCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#giftCardCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="visually-hidden">Siguiente</span>
