        </div>

       
        <div class="gift-text text-center text-lg-start text-white">
            <h2 class="fw-bold">YO DECIDO COMPARTIR<br>ALGO HEALTHY</h2>
            <p class="fs-5 mb-0">REGALA UNA GIFT CARD</p>
        </div>
    </div>
</section>


