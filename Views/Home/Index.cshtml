@{
    ViewData["Title"] = "Super Salads";
}

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
             <img src="https://static.wixstatic.com/media/d606f3_59850432cfdd4507a547397bbd1b1e5d~mv2.png" alt="SuperSalads" height="29">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item"><a class="nav-link" href="#">Rewards</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sucursales">Sucursales</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Tu Evento</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                <li class="nav-item ms-lg-3"><a class="btn btn-order" asp-controller="Home" asp-action="IniciarSesion">INICIAR SESION</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="overlay"></div>
    <img src="~/images/bannerp.jpg" alt="Banner principal" class="hero-bg">
</section>

<!-- IMAGEN 2 -->
<section class="hero-below">
    <img src="~/images/healthy.jpg" alt="Imagen Healthy" class="hero-below-img">
</section>




<!-- GIFT CARDS -->
<section class="gift-section py-5">
    <div class="container d-flex flex-column flex-lg-row align-items-center justify-content-center gap-5">

        <!-- Carrusel -->
        <div id="giftCardCarousel" class="carousel slide gift-carousel" data-bs-ride="carousel">
            <div class="carousel-inner rounded shadow">
                <div class="carousel-item active">
                    <img src="https://static.wixstatic.com/media/d606f3_629bd8c05521457cbc34eed2bb7c984e~mv2.jpg" class="d-block w-100 rounded" alt="Gift 1">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_a04e05565fa44e77803f5f16c6efa316~mv2.jpg" class="d-block w-100 rounded" alt="Gift 2">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_76c2f1c370a24084a7dc7a33e41e06fc~mv2.jpg" class="d-block w-100 rounded" alt="Gift 3">
                </div>
                <div class="carousel-item">
                    <img src="https://static.wixstatic.com/media/d606f3_e8bc30ff14d74bdca0da028974f73f32~mv2.jpg" class="d-block w-100 rounded" alt="Gift 4">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#giftCardCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#giftCardCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>

       
        <div class="gift-text text-center text-lg-start text-white">
            <h2 class="fw-bold">YO DECIDO COMPARTIR<br>ALGO HEALTHY</h2>
            <p class="fs-5 mb-0">REGALA UNA GIFT CARD</p>
        </div>
    </div>
</section>


<!-- PIDE ANTICIPADO -->
<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold">PIDE ANTICIPADO, ORDENA DESDE LA APP</h2>
        <a href="#" class="btn btn-light-custom mt-3">ORDENA AQUÍ</a>
        <div class="d-flex justify-content-center flex-wrap gap-3 mt-5">
            <img src="https://static.wixstatic.com/media/d606f3_97845bed7f7e41408c81c3ee6aaa37ad~mv2.png" class="rounded-circle">
            <img src="https://static.wixstatic.com/media/d606f3_8a99bf8f4b3a481f8256c8df38abbf84~mv2.png" class="rounded-circle">
            <img src="https://static.wixstatic.com/media/d606f3_bcb756acd49048b2a56aa4d4fa9331e3~mv2.png" class="rounded-circle">
            <img src="https://static.wixstatic.com/media/d606f3_2848fc03abb3450796659805a89c73a2~mv2.png" class="rounded-circle">
            <img src="https://static.wixstatic.com/media/d606f3_0d8c595862a14c52bf81151508ef23d2~mv2.png" class="rounded-circle">
        </div>
    </div>
</section>

<footer class="footer">
    <div class="container text-center">
        <div class="row justify-content-center align-items-start footer-links">
            <div class="col-6 col-md-2 mb-3">
                <ul class="list-unstyled">
                    <li><a href="#">Descarga la App</a></li>
                    <li><a href="#">Facturación</a></li>
                    <li><a href="#">Legales Promociones</a></li>
                    <li><a href="#">Gift Cards</a></li>
                </ul>
            </div>

            <div class="col-6 col-md-2 mb-3">
                <ul class="list-unstyled">
                    <li><a href="#">Aviso de Privacidad</a></li>
                    <li><a href="#">Rewards</a></li>
                    <li><a href="#">Términos y Condiciones</a></li>
                    <li><a href="#">Franquicias</a></li>
                </ul>
            </div>

            <div class="col-6 col-md-2 mb-3">
                <ul class="list-unstyled">
                    <li><a href="#">Únete al Equipo</a></li>
                    <li><a href="#">Tu Evento</a></li>
                </ul>
            </div>

            <div class="col-12 col-md-3 d-flex justify-content-center align-items-center">
                <img src="~/images/footer.png" alt="Super Salads" class="footer-icon">
            </div>
        </div>

        <hr class="footer-divider" />

        <div class="footer-bottom text-center">
            <p>Derechos reservados Super Salads Sa de Cv 2025</p>
            <div class="social-icons">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-tiktok"></i></a>
            </div>
        </div>
    </div>
</footer>



