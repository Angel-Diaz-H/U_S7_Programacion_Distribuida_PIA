@using TuProyecto.Models
@{
    Layout = null;
    var active = ViewData["ActiveOrders"] as IEnumerable<OrderModel> ?? Enumerable.Empty<OrderModel>();
    var past = ViewData["PastOrders"] as IEnumerable<OrderModel> ?? Enumerable.Empty<OrderModel>();

    string FormatDate(string d)
    {
        if (string.IsNullOrWhiteSpace(d)) return d;
        if (DateOnly.TryParse(d, out var dt)) return dt.ToString("dd/MM/yyyy");
        return d;
    }
}

<div class="my-orders">
    <h4 class="mb-3">Reservaciones activas</h4>
    @if (!active.Any())
    {
        <div class="alert alert-info">No tienes reservaciones activas.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach(var o in active)
            {
                <div class="col-md-6">
                    <div class="order-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5>@o.BranchName</h5>
                                <div class="order-meta">Fecha: <strong>@FormatDate(o.Date)</strong> · Hora: <strong>@o.Hour</strong></div>
                                <div class="order-meta">Personas: <strong>@o.Persons</strong></div>
                            </div>
                            <div class="order-actions">
                                <button class="btn btn-success btn-pill-sm my-2" onclick="openEdit(@o.Id)">Editar</button>
                                <button class="btn btn-secondary btn-pill-sm" onclick="cancelOrder(@o.Id)">Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h4 class="mt-4 mb-3">Histórico</h4>
    @if (!past.Any())
    {
        <div class="alert alert-secondary">No hay reservaciones pasadas.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach(var o in past)
            {
                <div class="col-md-6">
                    <div class="order-card bg-light">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6>@o.BranchName</h6>
                                <div class="order-meta">Fecha: <strong>@FormatDate(o.Date)</strong> · Hora: <strong>@o.Hour</strong></div>
                                <div class="order-meta">Estado: <span class="order-state">@((string.IsNullOrWhiteSpace(o.Status) ? "active" : o.Status))</span></div>
                            </div>
                            <div>
                                <button class="btn btn-danger btn-pill-sm" onclick="deleteOrder(@o.Id)">Eliminar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>