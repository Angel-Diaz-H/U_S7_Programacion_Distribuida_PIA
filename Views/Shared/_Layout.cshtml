<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bowlly’s</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo1.png" alt="SuperSalads" height="49">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Nosotros">Nosotros</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sucursales">Sucursales</a></li>
                    @*<li class="nav-item"><a class="nav-link" href="#">Rewards</a></li>*@
                    @*<li class="nav-item"><a class="nav-link" href="#">Tu Evento</a></li>*@
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                    <li class="nav-item ms-lg-3"><a class="btn btn-order" asp-controller="Home" asp-action="IniciarSesion">Iniciar sesión</a></li>
                </ul>
            </div>
        </div>
    </nav>
    @RenderBody()

    <footer class="footer">
        <div class="container text-center">
            <div class="row justify-content-center align-items-start footer-links">
                <div class="col-6 col-md-2 mb-3">
                    <ul class="list-unstyled">
                        <li><a href="#">Descarga la App</a></li>
                        <li><a href="#">Facturación</a></li>
                        <li><a href="#">Legales Promociones</a></li>
                        <li><a href="#">Gift Cards</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2 mb-3">
                    <ul class="list-unstyled">
                        <li><a href="#">Aviso de Privacidad</a></li>
                        <li><a href="#">Rewards</a></li>
                        <li><a href="#">Términos y Condiciones</a></li>
                        <li><a href="#">Franquicias</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2 mb-3">
                    <ul class="list-unstyled">
                        <li><a href="#">Únete al Equipo</a></li>
                        <li><a href="#">Tu Evento</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3 d-flex justify-content-center align-items-center">
                    <img src="~/images/footer.png" alt="Super Salads" class="footer-icon">
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="footer-bottom text-center">
                <p>Derechos reservados Super Salads Sa de Cv 2025</p>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>