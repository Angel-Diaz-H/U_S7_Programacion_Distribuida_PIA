<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bowlly’s</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo1.png" alt="SuperSalads" height="49">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sucursales">Sucursales</a>
                    </li>
                    @*<li class="nav-item"><a class="nav-link" href="#">Rewards</a></li>*@
                    @*<li class="nav-item"><a class="nav-link" href="#">Tu Evento</a></li>*@
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contacto">Contacto</a></li>

                    @* Ordenar/Reservar button: use a distinct filled green rounded style here, leave Iniciar sesión as btn-order *@
                    @if (Context.Session.GetString("LoggedInUser") != null)
                    {
                    <li class="nav-item ms-3">
                        <a class="btn btn-success rounded-pill px-4 text-white" asp-controller="Home"
                            asp-action="Ordenar">Reservar</a>
                    </li>
                    }
                    else
                    {
                    <li class="nav-item ms-3">
                        <a class="btn btn-success rounded-pill px-4 text-white" asp-controller="Home"
                            asp-action="IniciarSesion">Reservar</a>
                    </li>
                    }

                    @if (Context.Session.GetString("LoggedInUser") != null)
                    {
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-success d-flex align-items-center gap-2" asp-controller="Home"
                            asp-action="MiCuenta">
                            <span>@(Context.Session.GetString("LoggedInDisplayName") ?? "Mi cuenta")</span>
                        </a>
                    </li>
                    }
                    else
                    {
                    <li class="nav-item ms-lg-3"><a class="btn btn-order" asp-controller="Home"
                            asp-action="IniciarSesion">Iniciar sesión</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    @RenderBody()

    <footer class="footer">
        <div class="container">
            <!-- Footer dividido en 3 partes: izquierda / centro / derecha -->
            <div class="row align-items-center py-4">
                <!-- Izquierda: Enlaces rápidos -->
                <div class="col-12 col-md-4 mb-3 mb-md-0">
                    <div class="row">
                        <div class="col-6">
                            <ul class="list-unstyled">
                                <li><a asp-controller="Home" asp-action="Ordenar">Reserva aquí</a></li>
                                @* <li><a href="#">Facturación</a></li> *@
                                @* <li><a href="#">Legales Promociones</a></li> *@
                            </ul>
                        </div>
                        <div class="col-6">
                            <ul class="list-unstyled">
                                @* <li><a href="#">Gift Cards</a></li> *@
                                <li><a asp-controller="Home" asp-action="AvisoPrivacidad">Aviso de privacidad</a></li>
                                @* <li><a href="#">Rewards</a></li> *@
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Centro: Logo y breve texto -->
                <div class="col-12 col-md-4 text-center mb-3 mb-md-0">
                    <img src="~/images/Logo1.png" alt="Bowlly's" class="footer-icon img-fluid"
                        style="max-width:140px; height:auto;">
                    <p class="mt-3 mb-0">Bowlly's <br /> Combinando sabor y bienestar desde hace 5 años. Ven y forma parte
                        de nuestra historia.</p>
                </div>

                <!-- Derecha: Contacto y redes -->
                <div class="col-12 col-md-4 text-md-end text-center">
                    <p class="mb-1">Contacto</p>
                    <p class="mb-1">Tel: <a href="tel:+521 8123456789">(81) 2345 6789 </a></p>
                    <p class="mb-1">Email: <a href="mailto:info@bowllys.com">info@bowllys.com</a></p>
                    <div class="social-icons mt-2">
                        <a href="https://www.facebook.com/" target="_blank" class="me-2"><i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://www.instagram.com/" target="_blank" class="me-2"><i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://www.tiktok.com/es" target="_blank" class="me-2"><i class="fab fa-tiktok"></i>
                        </a>
                    </div>
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="footer-bottom text-center py-2">
                <p class="mb-0">® Derechos reservados Bowlly's S.A. de CV. 2025.</p>
            </div>
        </div>
    </footer>

    <!-- toast container (toasts appended by JS) -->
    <div id="toastContainer" aria-live="polite" aria-atomic="true"
        style="position:fixed; top:16px; right:16px; z-index:11000;"></div>

    <!-- Reusable confirm modal (used by myorders.js) -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-body">
            <p id="confirmModalMessage">¿Confirmar?</p>
          </div>
          <div class="modal-footer">
            <button type="button" id="confirmCancelBtn" class="btn btn-secondary"
                data-bs-dismiss="modal">Cancelar</button>
            <button type="button" id="confirmOkBtn" class="btn btn-success">Aceptar</button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/myorders.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>